# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交）。
# deploy.sh 会自动生成 SITE_DOMAIN 与 POSTGRES_PASSWORD。

# 裸域名，不带 https:// 也不带路径。必须已经解析到本服务器 IP。
SITE_DOMAIN=inch.example.com

# 数据库密码：建议 32 位十六进制，只用字母数字，避免 URL 转义问题。
POSTGRES_PASSWORD=change_me_to_a_long_random_hex

# ---------- 邮箱验证码（注册必须绑定邮箱）----------
# 不配置也能启动，只是注册会返回 503 MAIL_NOT_CONFIGURED。
# 以 QQ 邮箱为例：设置 → 账户 → 开启「IMAP/SMTP 服务」→ 生成授权码，授权码就是 SMTP_PASS。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_authorization_code
# 发件人显示名，可留空（留空则用 SMTP_USER）
MAIL_FROM=INCH <your_account@qq.com>
